  "task_2_3_proven_engine_gaps": [
    {
      "gap_id": "GAP-1-WORKER-TRIED-FRESH",
      "source": "/Users/elvis/.agent-autoloop/app/worker/worker.ts:289-303",
      "mechanism": "When turn 1 fails with `seen.error` or empty text and `!seen.started` on a bound `entry.resume`, worker sets `entry.triedFresh = true`, `entry.resume = null`, `entry.session = randomUUID()`, and immediately launches Turn 2 in a new session."
    },
    {
      "gap_id": "GAP-2-KERNEL-RETRY-LATER-10X",
      "source": "/Users/elvis/.agent-autoloop/app/kernel/decide.ts:39,289-332,396",
      "mechanism": "Any `outcome: \"failed\"` (including caller/wrapper SIGKILL exit 137 or wrapper pre-launch guard rejection) enters `retryLater()` and automatically re-queues the run up to `MAX_ATTEMPTS = 10` times without consulting per-rule retry limits."
    },
    {
      "gap_id": "GAP-3-WORKER-TIMEOUT-HARDCODED-FAILED",
      "source": "/Users/elvis/.agent-autoloop/app/worker/worker.ts:281-287,376-377",
      "mechanism": "When worker timeout triggers `stop(entry, \"timeout\")`, `conclude()` checks `if (entry.why === \"timeout\")` before `resultFrom(readMessage(seen.text))`, ignoring adapter output and unconditionally returning `{ outcome: \"failed\" }`, which triggers `retryLater()`."
    },
    {
      "gap_id": "GAP-4-UNKNOWN-SETTLE-SESSION-WIPES-RESUME",
      "source": "/Users/elvis/.agent-autoloop/app/kernel/decide.ts:116-127,223-230",
      "mechanism": "After `sweep()` marks a run `state: \"unknown\"` past `RUN_LEASE` (5m), `settleSession()` sees `going` (`claimed` or `unknown`) holding the same session and executes `put(draft, \"runs\", run.id, nulls(\"session\", \"resume\"))`, silently wiping explicit `resume` on subsequent runs."
    }
  ]
